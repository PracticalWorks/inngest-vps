# Copy to .env (auto-created on first deploy if missing)
#
# Generate hex keys (self-hosted requirement):
#   openssl rand -hex 16   → INNGEST_EVENT_KEY
#   openssl rand -hex 32   → INNGEST_SIGNING_KEY
#   openssl rand -hex 16   → PG_PASSWORD

INNGEST_DOMAIN=inngest.example.com

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
PG_PASSWORD=

# Fly target only: use Supabase's session pooler (port 5432), a dedicated
# database or non-tenant schema, and sslmode=require. Never use schema=app.
# INNGEST_POSTGRES_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/inngest?sslmode=require&options=-c%20search_path%3Dinngest
# FLY_REDIS_URL=redis://<redis-app>.internal:6379
# FLY_APP_NAME=inngest-oss
# FLY_REGION=iad

INNGEST_QUEUE_WORKERS=200
INNGEST_POLL_INTERVAL=60
INNGEST_LOG_LEVEL=info
