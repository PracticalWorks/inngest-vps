# Fly.io target for Inngest OSS. Copy to fly.toml and set app/region values.
app = "inngest-oss"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[env]
  INNGEST_QUEUE_WORKERS = "200"
  INNGEST_POLL_INTERVAL = "60"
  INNGEST_LOG_LEVEL = "info"
  INNGEST_JSON = "true"

[http_service]
  internal_port = 8288
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

  [http_service.concurrency]
    type = "connections"
    hard_limit = 200
    soft_limit = 150

[[vm]]
  memory = "1024mb"
  cpu_kind = "shared"
  cpus = 1

[[checks]]
  name = "health"
  type = "http"
  port = 8288
  path = "/health"
  interval = "30s"
  timeout = "10s"
  grace_period = "60s"
